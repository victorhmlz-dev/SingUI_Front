<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           styleClass="auth-root" stylesheets="@auth.css"
           prefWidth="900" prefHeight="680">

    <Button fx:id="backButton" styleClass="auth-back-button" StackPane.alignment="TOP_LEFT">
        <graphic>
            <Region styleClass="icon, icon-back"/>
        </graphic>
        <StackPane.margin>
            <Insets top="20" left="20"/>
        </StackPane.margin>
    </Button>

    <VBox alignment="CENTER" maxWidth="440" maxHeight="-Infinity">

        <Label styleClass="auth-title" text="Change Password"/>
        <Label styleClass="auth-subtitle" text="Choose a new, secure password"/>

        <VBox styleClass="auth-card">

            <HBox styleClass="auth-input">
                <Region styleClass="icon, icon-lock"/>
                <PasswordField fx:id="currentPasswordField" promptText="Current password" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox styleClass="auth-input">
                <Region styleClass="icon, icon-lock"/>
                <PasswordField fx:id="newPasswordField" promptText="New password" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label styleClass="auth-helper" text="At least 8 characters"/>

            <HBox styleClass="auth-input">
                <Region styleClass="icon, icon-lock"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label fx:id="errorLabel" styleClass="auth-error" managed="false" visible="false"/>

            <Button fx:id="updatePasswordButton" styleClass="auth-button" text="Update Password"
                    maxWidth="Infinity" defaultButton="true"/>

            <HBox alignment="CENTER">
                <Hyperlink fx:id="cancelLink" styleClass="auth-link" text="Cancel"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
