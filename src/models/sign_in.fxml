<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           styleClass="auth-root" stylesheets="@auth.css"
           prefWidth="900" prefHeight="680">

    <VBox alignment="CENTER" maxWidth="440" maxHeight="-Infinity">

        <Label styleClass="auth-title" text="Welcome Back!"/>
        <Label styleClass="auth-subtitle" text="Sign in to your account"/>

        <VBox styleClass="auth-card">

            <HBox styleClass="auth-input">
                <Region styleClass="icon, icon-email"/>
                <TextField fx:id="emailField" promptText="Email" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox styleClass="auth-input">
                <Region styleClass="icon, icon-lock"/>
                <PasswordField fx:id="passwordField" promptText="Password" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox alignment="CENTER_RIGHT">
                <Hyperlink fx:id="forgotPasswordLink" styleClass="auth-link" text="Forgot Password?"/>
            </HBox>

            <Button fx:id="signInButton" styleClass="auth-button" text="Sign In"
                    maxWidth="Infinity" defaultButton="true"/>

        </VBox>

        <HBox styleClass="auth-footer">
            <Label text="Don't have an account?"/>
            <Hyperlink fx:id="signUpLink" text="Sign Up"/>
        </HBox>
    </VBox>
</StackPane>
