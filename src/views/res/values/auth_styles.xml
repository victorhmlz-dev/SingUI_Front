<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="auth_gradient_start">#667EEA</color>
    <color name="auth_gradient_end">#764BA2</color>
    <color name="auth_primary">#667EEA</color>
    <color name="auth_input_bg">#F8F9FA</color>
    <color name="auth_input_stroke">#E9ECEF</color>
    <color name="auth_divider">#E0E0E0</color>
    <color name="auth_text_primary">#333333</color>
    <color name="auth_text_secondary">#757575</color>

    <style name="Auth" />

    <style name="Auth.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#33000000</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <style name="Auth.Subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">32dp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Auth.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@android:color/white</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">12dp</item>
    </style>

    <style name="Auth.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">@color/auth_input_bg</item>
        <item name="boxStrokeColor">@color/auth_input_stroke_selector</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/auth_primary</item>
        <item name="startIconTint">@color/auth_primary</item>
        <item name="endIconTint">@color/auth_text_secondary</item>
    </style>

    <style name="Auth.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_auth_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">6dp</item>
    </style>

    <style name="Auth.SocialButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/auth_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/auth_divider</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@null</item>
    </style>

    <style name="Auth.FooterText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Auth.FooterLink" parent="Auth.FooterText">
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
